    <worksheet name='1.1 Category profitability'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='q1_category_profitability' name='federated.1e2zac10m7axt21d1h3c01f4odkr' />
          </datasources>
          <datasource-dependencies datasource='federated.1e2zac10m7axt21d1h3c01f4odkr'>
            <column caption='avg_profit_per_order' datatype='real' name='[Calculation_0162761119924225]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([profit]) / COUNT([order_id])' />
            </column>
            <column caption='profit_margin_pct' datatype='real' name='[Calculation_0763094433828864]' role='measure' type='quantitative'>
